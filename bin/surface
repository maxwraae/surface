#!/usr/bin/env bash
# surface — put something on a screen.
#
#   surface ~/Documents/draft.html        render a file in a window
#   surface https://linear.app/abc-123    open a URL in a window
#   surface --edit ~/notes/draft.html     open in the right viewer in edit mode
#   surface --app=<key> <file>            force a specific viewer (e.g. --app=raw)
#   surface show                          list open windows
#   surface --list-apps                   list installed viewers
#   cmd | surface                         pipe HTML in (auto-saved + opened)
#   surface --daemon                      start Surface as a daemon (LaunchAgent path)
#
# Reads ~/.config/surface/config.json. If `target` is `self` (or unset),
# windows open locally. If `target` is a peer URL, windows open there
# (file stays on this machine, peer renders the URL).
#
# Viewer routing: the local daemon decides via /_/resolve?path=<abs>, which
# is content-aware for HTML (honors `<meta name="surface" content="<key>">`
# and the legacy `<doc>` body element) and falls back to extension-based
# routing for everything else. --app=raw bypasses routing and renders the
# file URL directly in Chromium. --app=<key> forces a specific viewer.
#
# Prints the URL it opened to stdout. Non-zero exit on failure.

set -e

# Make brew's node visible to Electron's `env node` shebang under macOS
# non-interactive shells (SSH, LaunchAgent) where /opt/homebrew/bin isn't
# on PATH by default.
case ":$PATH:" in
  *:/opt/homebrew/bin:*) ;;
  *) export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH" ;;
esac

# Resolve through symlinks so `ln -s ~/surface/bin/surface ~/.local/bin/surface` works.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
APP_DIR="$REPO/app"

# ---- daemon path (deprecated — Surface is always a daemon now) ---------------
if [ "${1:-}" = "--daemon" ]; then
  echo "surface: --daemon is deprecated; Surface always runs as a daemon." >&2
  if [ -d "/Applications/Surface.app" ]; then
    open -a Surface
  elif [ -d "$HOME/Applications/Surface.app" ]; then
    open -a "$HOME/Applications/Surface.app"
  else
    exec "$APP_DIR/node_modules/.bin/electron" "$APP_DIR"
  fi
  exit 0
fi

# ---- parse flags --------------------------------------------------------------
EDIT=0
APP_OVERRIDE=""
LIST_APPS=0
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --edit) EDIT=1; shift ;;
    --list-apps) LIST_APPS=1; shift ;;
    --app=*) APP_OVERRIDE="${1#--app=}"; shift ;;
    --app) APP_OVERRIDE="$2"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]}"

# --edit is sugar for "force the doc editor" — it ALWAYS sends the file to
# the doc app for in-place editing, overriding any meta-tag or extension
# routing. Explicit --app=<key> takes precedence over --edit.
if [ "$EDIT" -eq 1 ] && [ -z "$APP_OVERRIDE" ]; then
  APP_OVERRIDE="doc"
fi

# ---- read config -------------------------------------------------------------
read_config() {
  python3 - <<PY
import json, os
defaults = {
  "port": 7878,
  "self": "http://localhost:7878",
  "target": "self",
}
path = os.path.expanduser("~/.config/surface/config.json")
cfg = dict(defaults)
try:
    with open(path) as f: cfg.update(json.load(f))
except FileNotFoundError:
    pass
print(cfg["port"])
print(cfg["self"])
print(cfg["target"])
PY
}

{ read PORT; read SELF; read TARGET; } < <(read_config)

if [ "$TARGET" = "self" ]; then
  TARGET="http://localhost:${PORT}"
fi
SELF="${SELF%/}"
LOCAL="http://localhost:${PORT}"  # always reach the local daemon directly for lookups

# ---- auto-launch daemon if not running --------------------------------------
ensure_daemon() {
  if curl -sS --connect-timeout 1 "${LOCAL}/_/health" >/dev/null 2>&1; then
    return 0
  fi

  if [ -d "/Applications/Surface.app" ]; then
    open -a Surface
  elif [ -d "$HOME/Applications/Surface.app" ]; then
    open -a "$HOME/Applications/Surface.app"
  else
    "$APP_DIR/node_modules/.bin/electron" "$APP_DIR" &
    disown
  fi

  local attempts=0
  while [ $attempts -lt 100 ]; do
    if curl -sS --connect-timeout 1 "${LOCAL}/_/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.05
    attempts=$((attempts + 1))
  done

  echo "surface: could not start daemon (timed out after 5s)" >&2
  exit 3
}

ensure_daemon

# ---- subcommand: show --------------------------------------------------------
if [ "${1:-}" = "show" ]; then
  RESP=$(curl -sS --connect-timeout 3 "${LOCAL}/_/windows" 2>/dev/null) || {
    echo "surface: daemon unreachable" >&2; exit 3
  }
  python3 -c "
import json, sys
data = json.load(sys.stdin)
wins = data.get('windows', [])
if not wins:
    print('no windows open')
    sys.exit(0)
for w in wins:
    f = w.get('file') or ''
    marker = ' *' if w.get('focused') else ''
    label = f if f else w.get('url', '')
    title = w.get('title', '')
    b = w.get('bounds', {})
    size = str(b.get('width','?')) + 'x' + str(b.get('height','?'))
    print(f'{w[\"id\"]:3d}  {size:>11s}  {title}{marker}')
    if label != title:
        print(f'     {label}')
" <<< "$RESP"
  exit 0
fi

# ---- --list-apps short-circuit -----------------------------------------------
if [ "$LIST_APPS" -eq 1 ]; then
  curl -sS "${LOCAL}/_/apps" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for app in data.get("apps", []):
    m = app["manifest"]
    print(f'\''{app["key"]:14s} {app["tier"]:7s} {m.get("description", "")}'\'')
    if m.get("extensions"):
        print(f'\''               extensions: {" ".join(m["extensions"])}'\'')
'
  exit 0
fi

# ---- ask the local daemon: which viewer for this file? ----------------------
# Content-aware — the daemon may peek inside .html files and honor a
# `<meta name="surface" content="<key>">` declaration (or the legacy <doc>
# body element) to override extension-based routing. Prints the viewer's
# entryPath, or empty string if the file should render raw.
viewer_entry_for_path() {
  local abs="$1"
  local enc
  enc="$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$abs")"
  curl -sS -o /tmp/.surface-resolve-resp.$$ -w '%{http_code}' \
    "${LOCAL}/_/resolve?path=${enc}" 2>/dev/null > /tmp/.surface-resolve-code.$$ || true
  local code; code=$(cat /tmp/.surface-resolve-code.$$ 2>/dev/null)
  rm -f /tmp/.surface-resolve-code.$$
  if [ "$code" != "200" ]; then
    rm -f /tmp/.surface-resolve-resp.$$
    echo ""
    return
  fi
  python3 -c '
import json
d = json.load(open("/tmp/.surface-resolve-resp.'"$$"'"))
if d.get("raw"):
    print("")
else:
    print(d.get("app", {}).get("entryPath", ""))
'
  rm -f /tmp/.surface-resolve-resp.$$
}

viewer_entry_for_key() {
  local key="$1"
  curl -sS -o /tmp/.surface-app-resp.$$ -w '%{http_code}' \
    "${LOCAL}/_/apps/${key}" 2>/dev/null > /tmp/.surface-app-code.$$ || true
  local code; code=$(cat /tmp/.surface-app-code.$$ 2>/dev/null)
  rm -f /tmp/.surface-app-code.$$
  if [ "$code" != "200" ]; then
    rm -f /tmp/.surface-app-resp.$$
    echo ""
    return
  fi
  python3 -c 'import json,sys; d=json.load(open("/tmp/.surface-app-resp.'"$$"'")); print(d.get("entryPath", ""))'
  rm -f /tmp/.surface-app-resp.$$
}

# URL-encode a filesystem path for use in a URL, preserving slashes so the
# path structure survives (spaces, &, ?, etc. get percent-encoded).
urlencode_path() {
  python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$1"
}

# Build the URL a renderer should load for the given absolute file path.
build_url_for_file() {
  local abs="$1"
  local file_url="${SELF}$(urlencode_path "$abs")"

  # --app=raw → bypass viewer routing.
  if [ "$APP_OVERRIDE" = "raw" ]; then
    echo "$file_url"
    return
  fi

  # --app=<key> → force a specific viewer.
  if [ -n "$APP_OVERRIDE" ]; then
    local entry
    entry="$(viewer_entry_for_key "$APP_OVERRIDE")"
    if [ -z "$entry" ]; then
      echo "surface: app '$APP_OVERRIDE' not installed (try --list-apps)" >&2
      return 1
    fi
    echo "$(build_viewer_url "$entry" "$file_url")"
    return
  fi

  # Default: ask the daemon for the viewer for this file (content-aware).
  local entry
  entry="$(viewer_entry_for_path "$abs")"

  if [ -n "$entry" ]; then
    echo "$(build_viewer_url "$entry" "$file_url")"
  else
    # Daemon says raw — render the file URL directly in Chromium.
    echo "$file_url"
  fi
}

# Compose the URL the renderer loads. `entry` is what the daemon reports as
# entryPath: either an absolute filesystem path (built-in / local app) or a
# fully-qualified URL (hosted app — manifest's URL entryPoint). For URL
# entries, return as-is with ?file=. For local paths, prefix with $SELF so
# the daemon's file-serving HTTP endpoint hosts the bundle.
build_viewer_url() {
  local entry="$1" file_url="$2"
  case "$entry" in
    http://*|https://*|file://*)
      # Hosted upstream. Append ?file= directly, respecting existing query.
      if [[ "$entry" == *\?* ]]; then
        echo "${entry}&file=${file_url}"
      else
        echo "${entry}?file=${file_url}"
      fi
      ;;
    *)
      echo "${SELF}$(urlencode_path "$entry")?file=${file_url}"
      ;;
  esac
}

# ---- resolve target argument or stdin ---------------------------------------
if [ -n "${1:-}" ]; then
  if [[ "$1" =~ ^https?:// ]]; then
    URL="$1"
  elif [ ! -e "$1" ]; then
    echo "surface: not a file or URL: $1" >&2
    exit 1
  else
    abs="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
    URL="$(build_url_for_file "$abs")" || exit $?
  fi
elif [ ! -t 0 ]; then
  mkdir -p "$HOME/.local/share/surface"
  TMP="$HOME/.local/share/surface/$(date +%Y%m%d-%H%M%S)-$$.html"
  cat > "$TMP"
  URL="$(build_url_for_file "$TMP")" || exit $?
else
  cat >&2 <<EOF
usage:
  surface <file>          render a file in a window
  surface <url>           open a URL in a window
  surface show            list open windows
  surface --edit <file>   open in the right viewer in edit mode
  surface --app=<key> <file>   force a specific viewer
  surface --list-apps     list installed viewers
  cmd | surface           pipe HTML in
  surface --daemon        run as daemon (typically via LaunchAgent)
EOF
  exit 2
fi

# ---- POST {url} to <target>/_/open ------------------------------------------
BODY="$(python3 -c 'import json,sys; print(json.dumps({"url": sys.argv[1]}))' "$URL")"

RESP_FILE="$(mktemp -t surface-resp.XXXXXX)"
trap 'rm -f "$RESP_FILE"' EXIT

set +e
HTTP=$(curl -sS -o "$RESP_FILE" -w '%{http_code}' \
  --connect-timeout 5 --max-time 10 \
  -X POST -H 'Content-Type: application/json' --data-raw "$BODY" \
  "${TARGET}/_/open" 2>/dev/null)
RC=$?
set -e

if [ "$RC" -ne 0 ] || [ -z "$HTTP" ]; then
  echo "surface: target ${TARGET} unreachable — daemon down or peer offline?" >&2
  exit 3
fi

if [ "$HTTP" -ge 400 ]; then
  echo "surface: target returned HTTP ${HTTP}" >&2
  cat "$RESP_FILE" >&2 || true
  echo >&2
  exit 4
fi

echo "$URL"
